---
// Every window with an address gets a page in both languages: /en/projects/hatan/ opens Hatan, and so on.
import OsPage from '../../layouts/OsPage.astro';
import { ROUTE } from '../../os/core.js';
export function getStaticPaths() {
  const pages = [...Object.entries(ROUTE).map(([app, path]) => ({ app, path })), { app: 'notfound', path: '404' }];
  return ['en', 'ar'].flatMap(lang => pages.map(({ app, path }) => ({ params: { lang, path: path || undefined }, props: { lang, app } })));
}
const { lang, app } = Astro.props as { lang: 'en' | 'ar'; app: string };
---
<OsPage lang={lang} app={app} noindex={app === 'notfound'} />
