---
import { copy, local, projects, site, url, type Locale } from '../data/site';
import { media } from '../data/project-media';
import ProjectVisual from './ProjectVisual.astro';
import ProjectList from './ProjectList.astro';
import Icon from './Icon.astro';
const {lang} = Astro.props as {lang:Locale};
const c=copy[lang];
const ar=lang==='ar';
const flagship=projects[0];
---
<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title">{local(site.headline,lang)}</h1>
  <div class="intro-bottom"><p>{ar ? 'أنا أمير الحاتمي، من الخبر. أبني تطبيقات للتعلّم والتواصل وتيسير العمل.' : 'I’m Amir Alhatemi, based in Al Khobar. I build apps for learning, communication, and practical work.'}</p><div class="hero-actions"><a class="button button-primary" href="#selected-work">{c.seeWork}<Icon name="next"/></a><a class="text-link" href={url(lang,'contact')}>{c.contact}<Icon/></a></div></div>
</section>
<section class="work-section wrap" id="selected-work" aria-labelledby="work-heading">
  <div class="section-heading"><h2 id="work-heading">{c.work}</h2><span>{ar ? 'تطبيقات الهاتف والويب وأدوات العمل' : 'Mobile, web, and tools for work'}</span></div>
  <article class="flagship">
    <a class="flagship-image" href={url(lang,'projects/hadayah-live')} tabindex="-1" aria-hidden="true"><ProjectVisual project={flagship} lang={lang} feature/></a>
    <div class="flagship-details"><div class="flagship-title"><h3><a href={url(lang,'projects/hadayah-live')}>{local(flagship.name,lang)}<Icon/></a></h3><p>{local(flagship.pitch,lang)}</p></div><div class="flagship-spec"><span>{local(flagship.status,lang)}</span><span dir="ltr">Flutter / Supabase / YouTube</span><a class="text-link" href={url(lang,'projects/hadayah-live')}>{c.caseStudy}<Icon/></a></div></div>
    <p class="image-caption">{local(media['hadayah-live'].caption,lang)}</p>
  </article>
  <div class="other-work"><h2 class="subsection-title">{c.moreWork}</h2><ProjectList lang={lang}/></div>
</section>
<section class="about-section wrap" aria-labelledby="about-heading" data-reveal>
  <h2 id="about-heading">{c.about}</h2><div class="about-copy"><p class="lead">{c.aboutTitle}</p><p>{c.bio}</p><div class="about-links"><a class="text-link" href={url(lang,'about')}>{ar ? 'المزيد عنّي' : 'More about me'}<Icon/></a><span>{ar ? 'العربية والإنجليزية' : 'Arabic & English'}</span></div></div>
</section>
<section class="principles-section wrap" aria-labelledby="principles-heading" data-reveal><h2 id="principles-heading">{c.approach}</h2><div class="principles">{c.principles.map(([heading,body])=><div><h3>{heading}</h3><p>{body}</p></div>)}</div></section>
<section class="contact-band wrap" aria-labelledby="contact-heading" data-reveal><div><h2 id="contact-heading">{c.contactTitle}</h2><p>{c.contactIntro}</p></div><a class="button button-primary" href={url(lang,'contact')}>{c.contact}<Icon/></a></section>
