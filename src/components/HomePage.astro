---
import Board from './Board.astro';
import Facts from './Facts.astro';
import Strip from './Strip.astro';
import Plate from './Plate.astro';
import Icon from './Icon.astro';
import StatusGlyph from './StatusGlyph.astro';
import Portrait from './Portrait.astro';
import ContactPanel from './ContactPanel.astro';
import { copy, lab, local, projects, reachLabel, url, type Locale } from '../data/site';
import { image, media, wall } from '../data/project-media';
const { lang } = Astro.props as { lang: Locale };
const c = copy[lang];
const flagship = projects[0];
const byslug = Object.fromEntries(projects.map(p => [p.slug, p]));
---
<Board lang={lang} />

<section class="spotlight wrap" aria-labelledby="spotlight-title">
  <div class="spotlight-head">
    <h2 id="spotlight-title" class="section-title led">{c.flagshipTitle}</h2>
    <Facts facts={flagship.facts.slice(0, 3)} lang={lang} />
  </div>
  <Strip ids={media[flagship.slug].phones ?? []} lang={lang} label={`${local(flagship.name, lang)}, ${c.phone}`} />
  <a class="text-action" href={url(lang, `projects/${flagship.slug}`)}>{c.flagshipLink}<Icon name="next" /></a>
</section>

<section class="wall-section wrap" aria-labelledby="wall-title">
  <h2 id="wall-title" class="section-title led">{c.screensTitle}</h2>
  <p class="section-intro">{c.screensIntro}</p>
  <ul class="wall">
    {wall.map(item => {
      const img = image(item.id);
      const project = byslug[item.project];
      return (
        <li class:list={['wall-cell', img.kind === 'phone' ? 'wall-phone' : 'wall-desktop']}>
          <a href={url(lang, `projects/${item.project}`)} class="wall-link">
            <Plate id={item.id} lang={lang} frame="none" sizes={img.kind === 'phone' ? '(max-width: 700px) 40vw, 200px' : '(max-width: 700px) 90vw, 620px'} />
            <span class="wall-cap"><span class="wall-name led">{local(project.name, lang)}</span><span class="wall-note">{local(img.caption, lang)}</span></span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<section class="lab-section wrap" aria-labelledby="lab-title">
  <div class="lab-head">
    <h2 id="lab-title" class="section-title led">{c.labTitle}</h2>
    <p class="section-intro">{c.labIntro}</p>
  </div>
  <ul class="lab">
    {lab.map(item => (
      <li class="lab-item">
        <span class:list={['lab-glyph', `reach-${item.reach}`]} title={local(reachLabel[item.reach], lang)}><StatusGlyph reach={item.reach} /><span class="sr-only">{local(reachLabel[item.reach], lang)}</span></span>
        {item.link ? <a class="lab-name led ltr" href={item.link}>{item.name}<Icon /></a> : <span class="lab-name led ltr">{item.name}</span>}
        <span class="lab-line">{local(item.line, lang)}</span>
      </li>
    ))}
  </ul>
</section>

<section class="about-teaser wrap" aria-labelledby="about-title">
  <Portrait lang={lang} />
  <div class="about-copy">
    <h2 id="about-title" class="section-title led">{c.aboutTitle}</h2>
    <p>{c.bio}</p>
    <a class="text-action" href={url(lang, 'about')}>{c.moreAbout}<Icon name="next" /></a>
  </div>
</section>

<ContactPanel lang={lang} />
