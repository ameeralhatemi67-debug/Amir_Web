---
import type { Reach } from '../data/site';
// Status is drawn by pattern, never by colour alone: filled = public, half = limited, ring = private.
const { reach } = Astro.props as { reach: Reach };
---
<svg class:list={['glyph', `glyph-${reach}`]} viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
  {reach === 'public' && <circle cx="6" cy="6" r="5" fill="currentColor" />}
  {reach !== 'public' && <circle cx="6" cy="6" r="4.4" fill="none" stroke="currentColor" stroke-width="1.6" />}
  {reach === 'limited' && <path d="M6 1.6a4.4 4.4 0 0 1 0 8.8z" fill="currentColor" />}
</svg>
