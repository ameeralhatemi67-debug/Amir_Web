---
import { copy, local, projects, url, type Locale } from '../data/site';
import { media } from '../data/project-media';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
const { lang, includeFlagship = false, filters = true } = Astro.props as { lang: Locale; includeFlagship?: boolean; filters?: boolean };
const c = copy[lang];
const list = includeFlagship ? projects : projects.slice(1);
const RowHeading = includeFlagship ? 'h2' : 'h3';
---
<div class="project-collection" data-collection>
  {filters && <div class="filter-bar" role="group" aria-label={lang === 'ar' ? 'تصفية المشاريع' : 'Filter projects'}>
    {Object.entries(c.filters).filter(([key]) => key === 'all' || list.some(project => project.tags.includes(key))).map(([key, label]) => <button type="button" class="filter" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{label}</button>)}
  </div>}
  <div class="project-list">
    {list.map(project => <article class:list={['project-row', `tile-${project.slug}`]} data-tags={project.tags.join(' ')} data-reveal>
      <a class="project-thumbnail" href={url(lang, `projects/${project.slug}`)} tabindex="-1" aria-hidden="true"><ProjectVisual project={project} lang={lang} feature={includeFlagship && project.slug === 'hadayah-live'}/></a>
      <div class="project-row-body"><div class="project-title-line"><RowHeading class="project-row-heading"><a href={url(lang, `projects/${project.slug}`)}>{local(project.name, lang)}<Icon/></a></RowHeading><span class="project-category">{local(project.category, lang)}</span></div><p>{local(project.pitch, lang)}</p><div class="project-meta"><span>{local(project.status, lang)}</span><span dir="ltr">{project.stack.slice(0, 2).join(' / ')}</span></div><p class="image-caption">{local(media[project.slug].caption,lang)}</p></div>
    </article>)}
  </div>
  {filters && <p class="filter-result sr-only" aria-live="polite" data-filter-result data-result-label={c.result}></p>}
</div>
