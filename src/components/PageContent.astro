---
import HomePage from './HomePage.astro';
import CaseStudy from './CaseStudy.astro';
import Board from './Board.astro';
import Portrait from './Portrait.astro';
import ContactPanel from './ContactPanel.astro';
import Icon from './Icon.astro';
import { copy, local, projects, site, url, type Locale } from '../data/site';
const { lang, page = '' } = Astro.props as { lang: Locale; page?: string };
const c = copy[lang];
const ar = lang === 'ar';
const project = page.startsWith('projects/') ? projects.find(item => item.slug === page.split('/')[1]) : undefined;
const tools = ['Flutter / Dart', 'Kotlin', 'Next.js / React', 'TypeScript', 'Supabase / PostgreSQL', 'Prisma', 'Three.js', 'Python / FastAPI', 'Ollama'];
---
{page === '' && <HomePage lang={lang} />}

{page === 'projects' && <>
  <header class="page-head wrap"><h1 class="led">{c.projects}</h1><p class="lead">{c.workIntro}</p></header>
  <Board lang={lang} mode="index" />
</>}

{project && <CaseStudy project={project} lang={lang} />}

{page === 'about' && <div class="about-page">
  <header class="page-head wrap"><h1 class="led">{ar ? 'عنّي' : 'About me'}</h1><p class="lead">{local(site.headline, lang)}</p></header>
  <section class="about-intro wrap" aria-labelledby="about-name">
    <Portrait lang={lang} large />
    <div class="about-copy">
      <h2 id="about-name" class="section-title led">{c.aboutTitle}</h2>
      <p>{c.bio}</p>
      <p class="led unlit pending-line">{c.personalPending}</p>
      <dl class="facts about-facts">
        <div class="fact"><dt>{c.languages}</dt><dd>{c.native}<br />{c.english}</dd></div>
        <div class="fact"><dt>{ar ? 'المدينة' : 'Based in'}</dt><dd>{ar ? 'الخبر، المنطقة الشرقية' : 'Al Khobar, Eastern Province'}</dd></div>
      </dl>
    </div>
  </section>
  <section class="tools-section wrap" aria-labelledby="tools-title">
    <h2 id="tools-title" class="section-title led">{c.tools}</h2>
    <p class="section-intro">{c.toolsIntro}</p>
    <ul class="tool-board">{tools.map(tool => <li class="led ltr">{tool}</li>)}</ul>
  </section>
  <section class="principles wrap" aria-labelledby="principles-title">
    <h2 id="principles-title" class="section-title led">{c.approach}</h2>
    <ul class="principle-list">{c.principles.map(([heading, body]) => <li><h3 class="led">{heading}</h3><p>{body}</p></li>)}</ul>
  </section>
  <ContactPanel lang={lang} />
</div>}

{page === 'contact' && <ContactPanel lang={lang} page />}

{page === 'privacy' && <article class="prose-page wrap">
  <header class="page-head"><h1 class="led">{c.privacyTitle}</h1><p class="lead">{c.privacyIntro}</p></header>
  {c.privacySections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
  <a class="text-action" href={url(lang, 'contact')}>{c.contact}<Icon name="next" /></a>
</article>}

{page === '404' && <section class="error-page wrap">
  <div class="error-board">
    <p class="error-number led num" aria-hidden="true">404</p>
    <h1 class="led">{c.notFound}</h1>
    <p class="lead">{c.notFoundText}</p>
    <div class="error-actions"><a class="action" href={url(lang)}>{c.returnHome}<Icon name="next" /></a><a class="text-action" href={url(lang, 'projects')}>{c.projects}<Icon name="next" /></a></div>
  </div>
</section>}
